# Automated Trailing Stop Configuration
# Enable/disable automatic trailing stop functionality
TRAILING_STOP_ENABLED=true

# Tiered Trailing Stop System (Gestaffelte Stop-Loss-Schwellen)
# Format: profit_threshold:stop_offset (comma separated, in ascending order)
# profit_threshold = Minimum profit % to activate this tier
# stop_offset = Distance below current profit % to set stop loss
#
# Example calculation for profit=1.5%:
# - Tier >=0.5%: stop at 0.2% profit (fixed)
# - Tier >=1.0%: stop at profit-0.5% = 1.0% profit
# - Tier >=3.0%: not reached yet
#
# Example calculation for profit=11.5%:
# - Tier >=10%: stop at profit-3% = 8.5% profit
#
# Format: threshold1:offset1,threshold2:offset2,threshold3:offset3,...
# Special: Use negative offset for fixed profit target (e.g., 0.5:-0.2 means "set stop at +0.2% profit")
TRAILING_STOP_TIERS=0.5:-0.2,1.0:0.5,3.0:1.0,10.0:3.0

# Minimum price change required to update stop loss (percentage, e.g., 0.3 = 0.3%)
# Prevents excessive API calls for minor price movements
TRAILING_STOP_UPDATE_THRESHOLD_PCT=0.3

# Interval for checking and updating trailing stops (seconds)
# Default: 30 seconds. Lower values = more responsive but more API calls
TRAILING_STOP_CHECK_INTERVAL_SEC=30

# Allow AI to override automatic trailing stops (true/false)
# true = AI can manually adjust stop loss and take control
# false = AI updates are ignored, automatic trailing always active
TRAILING_STOP_ALLOW_AI_OVERRIDE=false

